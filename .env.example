# Copiar para .env (nunca commitar o .env real — já está no .gitignore)

# Ligação à base de dados MySQL, formato: mysql://user:password@host:port/database
# Numa base de dados local no mesmo servidor (ex.: MySQL da PTisp), o
# host é normalmente "localhost" e DB_SSL fica false. Se o fornecedor
# da base de dados exigir TLS, definir DB_SSL=true e, idealmente,
# DB_SSL_CA com o certificado CA fornecido por ele.
DB_URL="mysql://user:password@host:port/database"
DB_SSL=false
DB_SSL_CA=

# Gmail (usar uma "App Password", não a password normal da conta)
MAIL_USERNAME=
MAIL_PASSWORD=

# Notificações push (web-push) — gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:exemplo@dominio.com

# Segredo partilhado para o endpoint de envio de push em massa (components/send_push.php)
PUSH_ADMIN_SECRET=

# Segredo partilhado para criar novos administradores (components/regPrivacidade.php,
# rota /adPrivacidade). Enviar como "Authorization: Bearer <valor>". Sem isto
# definido, o endpoint fica desativado (403) — é essa a predefinição segura.
ADMIN_REGISTRATION_SECRET=

# URLs públicos desta app (sem barra final), usados em links de email.
# Atualizar sempre que mudar de plataforma — não voltar a hardcodar no código.
BACKEND_URL=https://api-sn.paroquiasaonicolau.pt
FRONTEND_URL=https://sn.paroquiasaonicolau.pt

# Segredo partilhado com o workflow de cron do GitHub Actions
# (.github/workflows/cron.yml), que chama components/enviar_lembretes.php
# periodicamente com este valor no header X-Cron-Secret. Tem de ser
# EXATAMENTE igual ao secret CRON_SECRET definido em Settings → Secrets
# and variables → Actions do repositório. Sem isto o endpoint devolve
# 500 (não configurado) ou 403 (valores diferentes) a qualquer chamada.
CRON_SECRET=
