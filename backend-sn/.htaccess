RewriteEngine On

# Garante que o header Authorization chega ao PHP mesmo que CGIPassAuth
# não esteja disponível/ativo (fallback universal via mod_rewrite).
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

# connect/ são ficheiros de suporte (ligação à BD, CORS, autenticação) —
# só devem ser carregados via require_once pelos endpoints em
# components/, nunca pedidos diretamente pelo browser.
RewriteRule ^connect/ - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
RewriteRule ^favicon.ico$ /path/to/favicon.ico [L]
